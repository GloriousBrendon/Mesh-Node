# mesh-node in seed mode without Docker (a VPS later), relay-only through
# n0's EU relay as in compose.yaml (SPEC-seed D8c as changed): it opens no
# port. A seed meant to take direct callers uses --port/--public instead.
[Unit]
Description=Mesh seed
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/mesh-node seed --data /var/lib/mesh-seed --relay-only --relay https://euc1-1.relay.n0.iroh.link. --mail --mail-max 2147483648
Restart=on-failure
DynamicUser=yes
StateDirectory=mesh-seed
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=
SystemCallArchitectures=native
MemoryMax=512M

[Install]
WantedBy=multi-user.target
